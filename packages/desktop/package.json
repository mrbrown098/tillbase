{
  "name": "@tillbase/desktop",
  "version": "0.5.0",
  "description": "Tillbase desktop point-of-sale app (Electron + React).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --external:better-sqlite3 --outdir=dist-electron --out-extension:.js=.cjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "rebuild": "node scripts/rebuild-native.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dist": "npm run build && node ../../scripts/build-installers.mjs",
    "dist:dir": "npm run build && node ../../scripts/build-installers.mjs --dir"
  },
  "dependencies": {
    "@tillbase/core": "*",
    "better-sqlite3": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  }
}
